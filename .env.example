# ===== LLM (任何 OpenAI Chat Completions 兼容服务) =====
LLM_API_KEY=***
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-llm-model-name

# ===== Embedding / Rerank / OCR (阿里云百炼 DashScope, 也可换成自部署模型) =====
DASHSCOPE_API_KEY=
EMBEDDIN…ting
EMBEDDING_DIM=1024
RERANK_MODEL=your-rerank-model
OCR_MODEL=your-ocr-model

# ===== 服务 =====
HOST=0.0.0.0
PORT=9012

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

# ===== 分块 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== 检索 =====
TOP_K_DENSE=20
TOP_K_RERANK=5

# ===== 会话 JWT =====
JWT_SECRET=change…ring
JWT_TTL_HOURS=8

# ===== 钉钉 (可选: 组织同步 / 扫码登录 / 事件订阅 / 工作通知) =====
DINGTALK_APP_KEY=
DINGTAL…ret=
DINGTALK_ROBOT_CODE=

# ===== 管理控制台公网前缀 (钉钉通知中的链接) =====
ADMIN_BASE_URL=https://your-domain.example.com

# ===== 日志 =====
LOG_LEVEL=INFO
