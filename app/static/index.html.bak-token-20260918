<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAG 智能客服</title>
<style>
  /* ============================================================
   * Reset & Base
   * ============================================================ */
  *, *::before, *::after { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    font-family: system-ui, -apple-system, "Segoe UI", "PingFang SC",
                 "Hiragino Sans GB", "Microsoft YaHei", Roboto, sans-serif;
    background: #ffffff;
    color: #1f2937;
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  button { font-family: inherit; cursor: pointer; }
  a { color: #2563eb; text-decoration: none; }

  /* ============================================================
   * App Layout
   * ============================================================ */
  .app {
    display: flex; flex-direction: column;
    height: 100vh; overflow: hidden;
  }

  /* ===== Top bar (50px) ===== */
  .topbar {
    height: 50px; flex-shrink: 0;
    border-bottom: 1px solid #e5e7eb;
    background: #ffffff;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 20px;
  }
  .topbar-left { display: flex; align-items: center; gap: 10px; }
  .topbar-logo {
    width: 28px; height: 28px;
    border-radius: 6px;
    background: #2563eb; color: #ffffff;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 700;
  }
  .topbar-title { font-size: 14px; font-weight: 600; color: #1f2937; }
  .topbar-sub   { font-size: 13px; color: #6b7280; margin-left: 4px; }
  .topbar-right { display: flex; align-items: center; gap: 4px; }
  .icon-btn {
    background: none; border: none;
    width: 32px; height: 32px;
    color: #6b7280; font-size: 16px;
    border-radius: 6px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .icon-btn:hover { background: #f3f4f6; color: #1f2937; }
  .icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .icon-btn:disabled:hover { background: none; color: #6b7280; }

  /* ============================================================
   * Body: sidebar + main
   * ============================================================ */
  .body { display: flex; flex: 1; min-height: 0; }

  /* ===== Sidebar (260px) ===== */
  .sidebar {
    width: 260px; flex-shrink: 0;
    border-right: 1px solid #e5e7eb;
    background: #fafafa;
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .sidebar-section {
    padding: 14px 14px 10px;
    border-bottom: 1px solid #e5e7eb;
    display: flex; flex-direction: column;
    min-height: 0;
  }
  .sidebar-section.flex { flex: 1; }
  .sidebar-section-title {
    font-size: 11px; font-weight: 600;
    color: #6b7280; text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 10px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .sidebar-section-title .count {
    font-weight: 500; color: #9ca3af;
    text-transform: none; letter-spacing: 0; font-size: 11px;
  }
  .sidebar-section-title .refresh {
    background: none; border: none;
    color: #9ca3af; font-size: 12px;
    padding: 2px 6px; border-radius: 4px;
    text-transform: none; letter-spacing: 0;
  }
  .sidebar-section-title .refresh:hover { background: #f3f4f6; color: #1f2937; }

  /* ===== Upload zone ===== */
  .upload-zone {
    border: 1px dashed #d1d5db;
    border-radius: 6px;
    padding: 14px 10px;
    text-align: center;
    color: #6b7280; font-size: 12px;
    background: #ffffff;
    cursor: pointer;
    transition: border-color .15s, background-color .15s;
  }
  .upload-zone:hover, .upload-zone.dragover {
    border-color: #2563eb; background: #eff6ff; color: #1f2937;
  }
  .upload-zone-icon { font-size: 22px; margin-bottom: 4px; line-height: 1; }
  .upload-zone-link { color: #2563eb; font-weight: 500; }
  .upload-zone input[type="file"] { display: none; }

  /* upload progress item */
  .upload-list { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; }
  .upload-item {
    padding: 8px 10px;
    background: #ffffff; border: 1px solid #e5e7eb;
    border-radius: 6px; font-size: 12px;
  }
  .upload-item-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 6px; gap: 6px;
  }
  .upload-item-name {
    color: #1f2937; font-weight: 500;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    flex: 1;
  }
  .upload-item-status { color: #6b7280; font-size: 11px; flex-shrink: 0; }
  .upload-item-status.done  { color: #10b981; font-weight: 500; }
  .upload-item-status.error { color: #dc2626; font-weight: 500; }
  .progress-bar {
    height: 3px; background: #e5e7eb;
    border-radius: 2px; overflow: hidden;
  }
  .progress-fill { height: 100%; background: #2563eb; border-radius: 2px; transition: width .2s; }
  .progress-fill.done  { background: #10b981; }
  .progress-fill.error { background: #dc2626; }

  /* ===== Doc list ===== */
  .doc-list {
    display: flex; flex-direction: column; gap: 1px;
    overflow-y: auto; max-height: 220px;
  }
  .doc-empty {
    padding: 12px 10px; text-align: center;
    color: #9ca3af; font-size: 12px;
  }
  .doc-item {
    padding: 7px 10px; border-radius: 6px;
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: #1f2937;
    transition: background-color .12s;
  }
  .doc-item:hover { background: #f3f4f6; }
  .doc-icon { font-size: 14px; line-height: 1; flex-shrink: 0; }
  .doc-name {
    flex: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .doc-meta { font-size: 11px; color: #6b7280; flex-shrink: 0; }
  .doc-del {
    border: none; background: transparent;
    color: #9ca3af; font-size: 14px;
    width: 22px; height: 22px;
    border-radius: 4px;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    opacity: 0; transition: opacity .15s, background-color .15s;
  }
  .doc-item:hover .doc-del { opacity: 1; }
  .doc-del:hover { background: #fee2e2; color: #dc2626; }

  /* ===== Conv list ===== */
  .conv-list {
    display: flex; flex-direction: column; gap: 1px;
    overflow-y: auto; min-height: 0;
  }
  .conv-empty {
    padding: 12px 10px; text-align: center;
    color: #9ca3af; font-size: 12px;
  }
  .conv-item {
    padding: 8px 10px; border-radius: 6px;
    cursor: pointer; font-size: 13px; color: #374151;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    display: flex; align-items: center; gap: 8px;
    transition: background-color .12s;
  }
  .conv-item:hover { background: #f3f4f6; }
  .conv-item.active { background: #e5e7eb; color: #1f2937; font-weight: 500; }
  .conv-icon { font-size: 12px; color: #9ca3af; flex-shrink: 0; }
  .conv-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .conv-time {
    color: #9ca3af; font-size: 11px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .conv-del {
    border: none; background: transparent;
    color: #9ca3af; font-size: 12px;
    width: 20px; height: 20px;
    border-radius: 4px;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    opacity: 0; transition: opacity .15s, background-color .15s;
  }
  .conv-item:hover .conv-del { opacity: 1; }
  .conv-del:hover { background: #fee2e2; color: #dc2626; }

  /* ============================================================
   * Main
   * ============================================================ */
  .main {
    flex: 1; min-width: 0;
    display: flex; flex-direction: column;
    background: #ffffff;
  }

  /* ===== Session title bar ===== */
  .session-bar {
    flex-shrink: 0;
    padding: 12px 20px;
    display: flex; align-items: center; justify-content: center;
    border-bottom: 1px solid #f3f4f6;
    position: relative;
  }
  .session-title {
    font-size: 14px; font-weight: 500;
    color: #1f2937;
    padding: 6px 14px;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color .15s;
    user-select: none;
    max-width: 70%;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .session-title:hover { background: #f3f4f6; }
  .session-title::before {
    content: "✎ "; color: #9ca3af; font-size: 11px; margin-right: 4px;
  }
  .session-title-edit {
    border: 1px solid #2563eb;
    background: #ffffff; outline: none;
    font-size: 14px; font-weight: 500;
    color: #1f2937;
    padding: 5px 12px;
    border-radius: 8px;
    width: 360px;
    text-align: center;
    font-family: inherit;
  }
  .session-bar-meta {
    position: absolute; right: 20px;
    font-size: 11px; color: #9ca3af;
  }
  .session-bar-meta .status-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #10b981;
    margin-right: 4px;
    vertical-align: middle;
  }
  .session-bar-meta .status-dot.off { background: #9ca3af; }

  /* ===== Chat area ===== */
  .chat-wrap {
    flex: 1; min-height: 0;
    overflow-y: auto;
  }
  .chat {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 24px 12px;
    display: flex; flex-direction: column;
  }

  /* message */
  .msg {
    margin-bottom: 28px;
    display: flex; gap: 14px; align-items: flex-start;
    animation: fadeIn .2s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .msg-avatar {
    width: 28px; height: 28px;
    border-radius: 6px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700;
    line-height: 1; color: #ffffff;
  }
  .msg.user .msg-avatar { background: #2563eb; }
  .msg.ai   .msg-avatar { background: #10b981; }
  .msg-body { flex: 1; min-width: 0; padding-top: 2px; }
  .msg-name {
    font-size: 13px; font-weight: 600;
    color: #1f2937; margin-bottom: 6px;
  }
  .msg-content {
    font-size: 14px; line-height: 1.7; color: #1f2937;
    word-wrap: break-word;
  }
  .msg-content p  { margin: 0 0 10px; }
  .msg-content p:last-child { margin-bottom: 0; }
  .msg-content ul,
  .msg-content ol { margin: 8px 0; padding-left: 22px; }
  .msg-content li { margin: 4px 0; }
  .msg-content code {
    background: #f3f4f6;
    padding: 1px 5px;
    border-radius: 3px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 13px;
  }
  .msg-content pre {
    background: #f3f4f6;
    padding: 10px 12px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13px;
    margin: 8px 0;
  }
  .msg-content pre code { background: transparent; padding: 0; }

  /* citation inline marker */
  .cite {
    display: inline-block;
    background: #eff6ff;
    color: #2563eb;
    border: 1px solid #dbeafe;
    border-radius: 4px;
    padding: 0 5px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    margin: 0 1px;
    vertical-align: text-top;
    line-height: 1.7;
    user-select: none;
    transition: background-color .12s;
  }
  .cite:hover { background: #dbeafe; }
  .cite.active { background: #2563eb; color: #ffffff; border-color: #2563eb; }

  /* sources footer */
  .sources {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed #e5e7eb;
    font-size: 12px;
    color: #6b7280;
    display: flex; flex-wrap: wrap; gap: 8px;
    align-items: center;
  }
  .sources-label {
    font-weight: 600; color: #1f2937;
    margin-right: 2px; font-size: 12px;
  }
  .source-item {
    cursor: pointer;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    display: inline-flex; align-items: center; gap: 4px;
    transition: background-color .12s, border-color .12s;
  }
  .source-item:hover { background: #f3f4f6; border-color: #d1d5db; }
  .source-item .source-num { color: #2563eb; font-weight: 700; }
  .source-item .source-name {
    color: #374151;
    max-width: 160px; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap;
  }

  /* expanded citation card */
  .cite-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-left: 3px solid #2563eb;
    border-radius: 4px;
    padding: 12px 14px;
    margin: 12px 0;
    font-size: 13px;
    line-height: 1.65;
    color: #374151;
  }
  .cite-card-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 8px; font-size: 12px;
    gap: 10px;
  }
  .cite-card-source {
    color: #1f2937; font-weight: 500;
    display: inline-flex; align-items: center; gap: 6px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    flex: 1; min-width: 0;
  }
  .cite-card-num {
    color: #2563eb; font-weight: 700;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    flex-shrink: 0;
  }
  .cite-card-text { color: #374151; white-space: pre-wrap; word-break: break-word; }
  .cite-card-score {
    margin-top: 6px;
    font-size: 11px; color: #9ca3af;
  }

  /* error message bubble */
  .msg.error .msg-avatar { background: #dc2626; }
  .msg.error .msg-name    { color: #dc2626; }

  /* empty / welcome state */
  .welcome {
    text-align: center;
    padding: 40px 20px 20px;
  }
  .welcome-title {
    font-size: 18px; font-weight: 600;
    color: #1f2937; margin-bottom: 8px;
  }
  .welcome-sub {
    font-size: 13px; color: #6b7280;
    margin-bottom: 22px;
  }
  .example-list {
    display: flex; flex-direction: column;
    gap: 8px; max-width: 460px;
    margin: 0 auto;
  }
  .example-item {
    padding: 10px 14px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    text-align: left;
    font-size: 13px;
    color: #1f2937;
    cursor: pointer;
    transition: background-color .15s, border-color .15s;
  }
  .example-item:hover {
    background: #eff6ff;
    border-color: #93c5fd;
  }
  .example-icon {
    color: #2563eb; margin-right: 6px;
  }

  /* loading dots */
  .typing {
    display: inline-flex; gap: 3px; padding: 4px 0;
  }
  .typing-dot {
    width: 6px; height: 6px;
    background: #9ca3af; border-radius: 50%;
    animation: typing 1.2s infinite ease-in-out;
  }
  .typing-dot:nth-child(2) { animation-delay: .15s; }
  .typing-dot:nth-child(3) { animation-delay: .3s; }
  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); opacity: .4; }
    30%           { transform: translateY(-4px); opacity: 1; }
  }

  /* ============================================================
   * Composer
   * ============================================================ */
  .composer {
    flex-shrink: 0;
    border-top: 1px solid #e5e7eb;
    padding: 14px 24px 16px;
    background: #ffffff;
  }
  .composer-inner { max-width: 760px; margin: 0 auto; }
  .composer-box {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px 10px 8px 14px;
    display: flex; gap: 8px; align-items: flex-end;
    background: #ffffff;
    transition: border-color .15s;
  }
  .composer-box:focus-within { border-color: #2563eb; }
  .composer-input {
    flex: 1; border: none; outline: none;
    resize: none;
    font-family: inherit; font-size: 14px;
    color: #1f2937;
    background: transparent;
    min-height: 28px; max-height: 180px;
    line-height: 1.5;
    padding: 6px 0;
  }
  .composer-input::placeholder { color: #9ca3af; }
  .composer-send {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    width: 34px; height: 34px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background-color .15s;
  }
  .composer-send:hover  { background: #1d4ed8; }
  .composer-send:disabled {
    background: #d1d5db; cursor: not-allowed;
  }
  .composer-hint {
    font-size: 11px; color: #9ca3af;
    margin-top: 8px; text-align: center;
  }

  /* ============================================================
   * Toast notifications
   * ============================================================ */
  .toast-stack {
    position: fixed;
    top: 70px; right: 24px;
    z-index: 2000;
    display: flex; flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }
  .toast {
    background: #1f2937; color: #ffffff;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    min-width: 200px; max-width: 360px;
    pointer-events: auto;
    animation: toastIn .2s ease;
  }
  .toast.error { background: #dc2626; }
  .toast.success { background: #10b981; }
  @keyframes toastIn {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ============================================================
   * Scrollbar
   * ============================================================ */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-thumb {
    background: #d1d5db; border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover { background: #9ca3af; }
  ::-webkit-scrollbar-track { background: transparent; }

  /* ============================================================
   * Responsive (narrow screens)
   * ============================================================ */
  @media (max-width: 720px) {
    .sidebar { width: 100%; max-width: 220px; }
  }
</style>
</head>
<body>

<!-- ===== Token 鉴权模态框 ===== -->
<div id="tokenModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:12px; padding:32px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    <h2 style="margin:0 0 8px 0; font-size:20px; color:#111;">🔐 RAG 智能客服</h2>
    <p style="margin:0 0 20px 0; color:#666; font-size:14px; line-height:1.5;">
      请输入访问令牌以继续使用。
    </p>
    <input id="tokenInput" type="password" placeholder="访问令牌"
           style="width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; box-sizing:border-box;" />
    <div id="tokenError" style="color:#dc2626; font-size:13px; margin-top:8px; min-height:18px;"></div>
    <button id="tokenSubmit"
            style="margin-top:16px; width:100%; padding:10px; background:#2563eb; color:#fff; border:none; border-radius:6px; font-size:14px; font-weight:500; cursor:pointer;">
      进入
    </button>
    <p style="margin-top:16px; color:#9ca3af; font-size:12px; text-align:center;">
      令牌会保存在浏览器本地,后续自动登录
    </p>
  </div>
</div>

<div class="app">

  <!-- ========================================================
       Top bar
       ======================================================== -->
  <header class="topbar">
    <div class="topbar-left">
      <div class="topbar-logo">R</div>
      <div>
        <span class="topbar-title">RAG 智能客服</span>
        <span class="topbar-sub">· 知识库问答</span>
      </div>
    </div>
    <div class="topbar-right">
      <button class="icon-btn" id="logoutBtn" title="切换令牌" aria-label="切换令牌"
              style="display:none;">
        🔓
      </button>
      <button class="icon-btn" id="newChatBtn" title="新建会话" aria-label="新建会话">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
        </svg>
      </button>
      <button class="icon-btn" id="refreshAllBtn" title="刷新全部" aria-label="刷新">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"></polyline>
          <polyline points="1 20 1 14 7 14"></polyline>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
      </button>
    </div>
  </header>

  <div class="body">

    <!-- ========================================================
         Sidebar
         ======================================================== -->
    <aside class="sidebar">

      <!-- Upload area -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">
          <span>文档上传</span>
        </div>
        <label class="upload-zone" id="uploadZone" for="fileInput">
          <div class="upload-zone-icon">⬆️</div>
          <div>点击或拖拽文件上传</div>
          <div style="margin-top: 3px;">支持 PDF / DOCX / TXT / MD</div>
