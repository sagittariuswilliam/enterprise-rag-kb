<!-- Toast container -->
<div class="toast-stack" id="toastStack"></div>

<script>
/* =================================================================
 * RAG 智能客服 - 前端逻辑
 *
 * 依赖:无外部库,纯原生 JS / CSS / HTML
 * API: http://localhost:9012(可在下面 API_BASE 修改)
 * ================================================================= */

(function () {
  'use strict';

  /* ========== 配置 ========== */
  const API_BASE = (location.protocol === 'file:')
    ? 'http://localhost:9012'                          // 直接打开 file://
    : (location.origin || 'http://localhost:9012');     // 同源部署
  const STORAGE_KEY_SESSION = 'rag_current_session_id';
  const ALLOWED_EXTS = ['.pdf', '.docx', '.txt', '.md', '.markdown'];

  /* ========== 全局状态 ========== */
  const state = {
    sessionId: null,        // 当前会话 id(null 表示新会话)
    sessionTitle: '新会话', // 当前会话标题(前端显示用)
    messages: [],           // 当前会话的全部消息 [{role, content, citations, ts}]
    citations: [],          // 最近一次 AI 回复的 citations
    documents: [],          // 知识库文档
    sessions: [],           // 会话列表
    busy: false,            // 是否有请求在飞
    editingTitle: false,    // 是否正在编辑标题
  };

  /* ========== DOM 引用 ========== */
  const $ = (id) => document.getElementById(id);
  const els = {
    uploadZone:        $('uploadZone'),
    fileInput:         $('fileInput'),
    uploadList:        $('uploadList'),
    docList:           $('docList'),
    docCount:          $('docCount'),
    refreshDocsBtn:    $('refreshDocsBtn'),
    convList:          $('convList'),
    sessionCount:      $('sessionCount'),
    refreshSessionsBtn:$('refreshSessionsBtn'),
    sessionTitle:      $('sessionTitle'),
    sessionTitleInput: $('sessionTitleInput'),
    statusDot:         $('statusDot'),
    statusText:        $('statusText'),
    chat:              $('chat'),
    chatWrap:          $('chatWrap'),
    welcomeBlock:      $('welcomeBlock'),
    composerInput:     $('composerInput'),
    sendBtn:           $('sendBtn'),
    newChatBtn:        $('newChatBtn'),
    refreshAllBtn:     $('refreshAllBtn'),
    toastStack:        $('toastStack'),
  };

  /* =================================================================
   * 工具函数
   * ================================================================= */

  function escapeHtml(s) {
    if (s === null || s === undefined) return '';
    return String(s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /** 把换行转成 <br>,并保留段落 */
  function nl2br(s) {
    return escapeHtml(s).replace(/\n/g, '<br>');
  }

  /** 轻量 markdown -> HTML(只覆盖常见语法,够 RAG 回答用) */
  function renderMarkdown(text) {
    if (!text) return '';
    let html = escapeHtml(text);

    // 代码块 ```...```
    html = html.replace(/```([\s\S]*?)```/g, function (_, code) {
      return '<pre><code>' + code + '</code></pre>';
    });
    // 行内代码 `...`
    html = html.replace(/`([^`\n]+)`/g, '<code>$1</code>');

    // 标题 ### / ## / #
    html = html.replace(/^### (.+)$/gm, '<h4>$1</h4>');
    html = html.replace(/^## (.+)$/gm,  '<h3>$1</h3>');
    html = html.replace(/^# (.+)$/gm,   '<h2>$1</h2>');

    // 引用标记 [1] [2] ... -> 可点击的 cite span
    html = html.replace(/\[(\d+)\]/g, function (_, n) {
      return '<span class="cite" data-cite="' + n + '" title="查看引用来源">[' + n + ']</span>';
    });

    // 粗体 **...**
    html = html.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
    // 斜体 *...*
    html = html.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');

    // 简单列表(以 - 或 * 开头)
    html = html.replace(/(^|\n)((?:- .+(?:\n|$))+)/g, function (m, pre, list) {
      const items = list.trim().split('\n').map(s => '<li>' + s.replace(/^- /, '') + '</li>').join('');
      return pre + '<ul>' + items + '</ul>';
    });
    // 有序列表 1. 2. 3.
    html = html.replace(/(^|\n)((?:\d+\. .+(?:\n|$))+)/g, function (m, pre, list) {
      const items = list.trim().split('\n').map(s => '<li>' + s.replace(/^\d+\. /, '') + '</li>').join('');
      return pre + '<ol>' + items + '</ol>';
    });

    // 段落(双换行)
    html = html.split(/\n{2,}/).map(function (block) {
      if (/^\s*<(h\d|ul|ol|pre|blockquote)/.test(block)) return block;
      return '<p>' + block.replace(/\n/g, '<br>') + '</p>';
    }).join('\n');

    return html;
  }

  /** 文件大小格式化 */
  function fmtSize(bytes) {
    if (!bytes && bytes !== 0) return '';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  /** 截短字符串 */
  function truncate(s, n) {
    if (!s) return '';
    return s.length > n ? s.slice(0, n) + '…' : s;
  }

  /** 时间格式 */
  function fmtTime(iso) {
    if (!iso) return '';
    try {
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      const pad = (x) => String(x).padStart(2, '0');
      return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
        + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    } catch (e) { return ''; }
  }

  /* =================================================================
   * Toast
   * ================================================================= */
  function toast(msg, type) {
    const el = document.createElement('div');
    el.className = 'toast' + (type ? ' ' + type : '');
    el.textContent = msg;
    els.toastStack.appendChild(el);
    setTimeout(function () {
      el.style.transition = 'opacity .3s';
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 300);
    }, 3000);
  }

  /* =================================================================
   * API 客户端
   * ================================================================= */
  // 鉴权 token（前端从 URL ?token= 或 localStorage 读取）
  function getToken() {
    let t = localStorage.getItem('rag_token');
    if (!t) {
      const params = new URLSearchParams(location.search);
      t = params.get('token');
      if (t) {
        localStorage.setItem('rag_token', t);
        // 清掉 URL 上的 token（美观）
        const url = new URL(location.href);
        url.searchParams.delete('token');
        history.replaceState(null, '', url.pathname + (url.search ? url.search : '') + url.hash);
      }
    }
    return t;
  }

  function setToken(t) {
    if (t) localStorage.setItem('rag_token', t);
    else localStorage.removeItem('rag_token');
  }

  function showTokenModal(msg) {
    const modal = document.getElementById('tokenModal');
    const err = document.getElementById('tokenError');
    const input = document.getElementById('tokenInput');
    modal.style.display = 'flex';
    if (msg) err.textContent = msg;
    else err.textContent = '';
    input.value = '';
    setTimeout(() => input.focus(), 100);
  }

  function hideTokenModal() {
    document.getElementById('tokenModal').style.display = 'none';
  }

  // 验证 token 有效性：通过 /api/upload/list 返回 200 即认为有效
  async function verifyToken(t) {
    try {
      const r = await fetch(buildUrlWith('/api/upload/list', t));
      return r.status === 200;
    } catch (e) {
      return false;
    }
  }

  function buildUrlWith(path, token) {
    if (token && path.startsWith('/api/')) {
      const sep = path.includes('?') ? '&' : '?';
      return API_BASE + path + sep + 'token=' + encodeURIComponent(token);
    }
    return API_BASE + path;
  }

  function buildUrl(path) {
    return buildUrlWith(path, getToken());
  }

  async function api(path, opts = {}) {
    const url = buildUrl(path);
    const init = { method: opts.method || 'GET', headers: opts.headers || {} };

    if (opts.body !== undefined) {
      if (opts.body instanceof FormData) {
        init.body = opts.body;                  // 浏览器自动加 multipart 边界
      } else if (typeof opts.body === 'string') {
        init.body = opts.body;
      } else {
        init.body = JSON.stringify(opts.body);
        init.headers['Content-Type'] = 'application/json';
      }
    }

    let respObj;
    try {
      const r = await fetch(url, init);
      const text = await r.text();
      let data = null;
      try { data = text ? JSON.parse(text) : null; } catch (e) { data = text; }
      if (!r.ok) {
        const detail = (data && data.detail) ? data.detail : (typeof data === 'string' ? data : r.statusText);
        throw new Error(typeof detail === 'string' ? detail : JSON.stringify(detail));
      }
      respObj = data;
    } catch (err) {
      // 网络层错误 或 后端 detail
      throw err;
    }
    return respObj;
  }

  /* =================================================================
   * 文档管理
   * ================================================================= */

  async function loadDocuments() {
    try {
      const data = await api('/api/upload/list');
      // 后端返回 {documents: [...], count: N}
      state.documents = (data && Array.isArray(data.documents)) ? data.documents : [];
      renderDocs();
    } catch (err) {
      console.error('loadDocuments:', err);
      els.docList.innerHTML = '<div class="doc-empty">加载失败</div>';
    }
  }

  function renderDocs() {
    els.docCount.textContent = state.documents.length + ' 篇';
    if (!state.documents.length) {
      els.docList.innerHTML = '<div class="doc-empty">暂无文档</div>';
      return;
    }
    els.docList.innerHTML = state.documents.map(function (d) {
      const name = escapeHtml(d.filename || d.source || '未命名');
      const chunks = d.chunks != null ? (d.chunks + ' 块') : '';
      const size  = d.size ? fmtSize(d.size) : '';
      const meta  = [chunks, size].filter(Boolean).join(' · ');
      return ''
        + '<div class="doc-item" data-source="' + escapeHtml(d.filename || d.source || '') + '">'
        +   '<span class="doc-icon">📄</span>'
        +   '<span class="doc-name" title="' + name + '">' + name + '</span>'
        +   '<span class="doc-meta">' + escapeHtml(meta) + '</span>'
        +   '<button class="doc-del" title="删除文档" aria-label="删除">×</button>'
        + '</div>';
    }).join('');
  }

  async function deleteDocument(source) {
    if (!source) return;
    if (!confirm('确认删除文档 "' + source + '" 及其全部 chunks?')) return;
    try {
      await api('/api/upload/' + encodeURIComponent(source), { method: 'DELETE' });
      toast('已删除: ' + source, 'success');
      await loadDocuments();
    } catch (err) {
      console.error('deleteDocument:', err);
      toast('删除失败: ' + err.message, 'error');
    }
  }

  /* =================================================================
   * 文件上传
   * ================================================================= */

  function addUploadItem(name) {
    const item = document.createElement('div');
    item.className = 'upload-item';
    item.innerHTML =
      '<div class="upload-item-row">'
      + '<span class="upload-item-name">📄 ' + escapeHtml(name) + '</span>'
      + '<span class="upload-item-status">0%</span>'
      + '</div>'
      + '<div class="progress-bar"><div class="progress-fill" style="width:0%"></div></div>';
    els.uploadList.prepend(item);
    return {
      el: item,
      statusEl: item.querySelector('.upload-item-status'),
      fillEl:   item.querySelector('.progress-fill'),
    };
  }

  function uploadFile(file) {
    return new Promise(function (resolve, reject) {
      // 扩展名校验
      const lower = file.name.toLowerCase();
      const ok = ALLOWED_EXTS.some(function (ext) { return lower.endsWith(ext); });
      if (!ok) {
        reject(new Error('不支持的文件类型: ' + file.name));
        return;
      }

      const ui = addUploadItem(file.name);
      const xhr = new XMLHttpRequest();
      xhr.open('POST', buildUrl('/api/upload'));

      xhr.upload.onprogress = function (e) {
        if (e.lengthComputable) {
          const pct = Math.round((e.loaded / e.total) * 100);
          ui.statusEl.textContent = pct + '%';
          ui.fillEl.style.width = pct + '%';
        }
      };

      xhr.onload = function () {
        let data = null;
        try { data = JSON.parse(xhr.responseText); } catch (e) {}
        if (xhr.status >= 200 && xhr.status < 300) {
          ui.statusEl.textContent = '✓ 已完成';
          ui.statusEl.classList.add('done');
          ui.fillEl.classList.add('done');
          ui.fillEl.style.width = '100%';
          resolve(data);
        } else {
          const msg = (data && data.detail) ? data.detail : ('HTTP ' + xhr.status);
          ui.statusEl.textContent = '✗ 失败';
          ui.statusEl.classList.add('error');
          ui.fillEl.classList.add('error');
          reject(new Error(typeof msg === 'string' ? msg : JSON.stringify(msg)));
        }
      };

      xhr.onerror = function () {
        ui.statusEl.textContent = '✗ 网络错误';
        ui.statusEl.classList.add('error');
        ui.fillEl.classList.add('error');
        reject(new Error('网络错误,请检查后端是否启动 (端口 9012)'));
      };

      const fd = new FormData();
      fd.append('file', file);
      xhr.send(fd);
    });
  }

  async function handleFiles(fileList) {
    if (!fileList || !fileList.length) return;
    setBusy(true);
    let okCount = 0, failCount = 0;
    for (const file of Array.from(fileList)) {
      try {
        await uploadFile(file);
        okCount++;
      } catch (err) {
        console.error('upload error:', err);
        toast(err.message || '上传失败', 'error');
        failCount++;
      }
    }
    setBusy(false);
    if (okCount) {
      toast('成功上传 ' + okCount + ' 个文档', 'success');
      await loadDocuments();
    }
    els.fileInput.value = '';   // 清空以便再次选同一文件
  }

  /* =================================================================
   * 会话管理
   * ================================================================= */

  async function loadSessions() {
    try {
      const data = await api('/api/history/list');
      state.sessions = (data && Array.isArray(data.sessions)) ? data.sessions : [];
      renderSessions();
    } catch (err) {
      console.error('loadSessions:', err);
      els.convList.innerHTML = '<div class="conv-empty">加载失败</div>';
    }
  }

  function renderSessions() {
    els.sessionCount.textContent = state.sessions.length + ' 条';
    if (!state.sessions.length) {
      els.convList.innerHTML = '<div class="conv-empty">暂无会话</div>';
      return;
    }
    els.convList.innerHTML = state.sessions.map(function (s) {
      const title = s.title || '未命名会话';
      const active = s.session_id === state.sessionId ? ' active' : '';
      const t = fmtTime(s.updated_at || s.created_at);
      return ''
        + '<div class="conv-item' + active + '" data-sid="' + escapeHtml(s.session_id) + '" title="' + escapeHtml(title) + '">'
        +   '<span class="conv-icon">💬</span>'
        +   '<span class="conv-title">' + escapeHtml(truncate(title, 24)) + '</span>'
        +   '<span class="conv-time">' + escapeHtml(t) + '</span>'
        +   '<span class="conv-del" title="删除会话" aria-label="删除">×</span>'
        + '</div>';
    }).join('');
    // t 已通过 conv-time 显示在 HTML 中
  }

  async function loadSession(sessionId) {
    if (!sessionId) return;
    try {
      const data = await api('/api/history/' + encodeURIComponent(sessionId));
      state.sessionId = data.session_id || sessionId;
      state.messages  = Array.isArray(data.messages) ? data.messages : [];

      // 标题:取首条 user 内容,或 session_id
      const firstUser = state.messages.find(function (m) { return m.role === 'user'; });
      state.sessionTitle = firstUser ? truncate(firstUser.content, 40) : ('会话 ' + state.sessionId);
      localStorage.setItem(STORAGE_KEY_SESSION, state.sessionId);
      renderSessionTitle();
      renderAllMessages();
      renderSessions();
      scrollChatToBottom();
    } catch (err) {
      console.error('loadSession:', err);
      toast('加载会话失败: ' + err.message, 'error');
    }
  }

  async function deleteSession(sessionId, e) {
    if (e) e.stopPropagation();
    if (!sessionId) return;
    if (!confirm('确认删除该会话?')) return;
    try {
      await api('/api/history/' + encodeURIComponent(sessionId), { method: 'DELETE' });
      toast('已删除会话', 'success');
      // 如果删除的是当前会话,重置
      if (state.sessionId === sessionId) {
        startNewChat();
      }
      await loadSessions();
    } catch (err) {
      console.error('deleteSession:', err);
      toast('删除失败: ' + err.message, 'error');
    }
  }

  function startNewChat() {
    state.sessionId = null;
    state.sessionTitle = '新会话';
    state.messages = [];
    state.citations = [];
    localStorage.removeItem(STORAGE_KEY_SESSION);
    renderSessionTitle();
    renderAllMessages();
    renderSessions();
  }

  /* =================================================================
   * 聊天渲染
   * ================================================================= */

  function renderSessionTitle() {
    els.sessionTitle.textContent = state.sessionTitle;
  }

  /** 渲染整段对话(切换会话时使用) */
  function renderAllMessages() {
    // 清空 chat 区(保留 welcome 的 DOM,先移除它再渲染)
    els.chat.innerHTML = '';
    if (!state.messages.length) {
      // 没有消息,显示欢迎
      const w = document.createElement('div');
      w.className = 'welcome';
      w.id = 'welcomeBlock';
      w.innerHTML =
        '<div class="welcome-title">👋 你好,我是 RAG 智能客服</div>'
        + '<div class="welcome-sub">基于已上传文档进行问答;回答会附带来源引用。</div>'
        + '<div class="example-list">'
        +   '<button class="example-item" data-q="请总结一下本文档的核心内容">'
        +     '<span class="example-icon">💡</span>请总结一下本文档的核心内容'
        +   '</button>'
        +   '<button class="example-item" data-q="这份文档主要讲了什么主题?">'
        +     '<span class="example-icon">📖</span>这份文档主要讲了什么主题?'
        +   '</button>'
        +   '<button class="example-item" data-q="请列出文档中的关键术语和定义">'
        +     '<span class="example-icon">🔑</span>请列出文档中的关键术语和定义'
        +   '</button>'
        + '</div>';
      els.chat.appendChild(w);
      return;
    }

    // 拼接 user / assistant 消息
    state.messages.forEach(function (msg) {
      if (msg.role === 'user') {
        appendUserMessage(msg.content, false);
      } else if (msg.role === 'assistant') {
        appendAIMessage(msg.content, msg.citations || [], false);
      }
    });

    // 把最后一次 AI 回答的 citations 缓存下来(用于 sources 高亮)
    const lastAssistant = [...state.messages].reverse().find(function (m) { return m.role === 'assistant'; });
    state.citations = lastAssistant && lastAssistant.citations ? lastAssistant.citations : [];
  }

  /** 追加一条用户消息;persist=false 表示只是渲染,不写 state(用于历史回放) */
  function appendUserMessage(content, persist) {
    const welcome = els.chat.querySelector('.welcome');
    if (welcome) welcome.remove();

    const el = document.createElement('div');
    el.className = 'msg user';
    el.innerHTML =
      '<div class="msg-avatar">U</div>'
      + '<div class="msg-body">'
      +   '<div class="msg-name">你</div>'
      +   '<div class="msg-content"><p>' + nl2br(content) + '</p></div>'
      + '</div>';
    els.chat.appendChild(el);

    if (persist !== false) {
      state.messages.push({ role: 'user', content: content, ts: new Date().toISOString() });
    }
    scrollChatToBottom();
  }

  /** 追加 AI 消息(含 citations) */
  function appendAIMessage(content, citations, persist) {
    const msgEl = document.createElement('div');
    msgEl.className = 'msg ai';

    const body = renderAIBody(content, citations);
    msgEl.innerHTML =
      '<div class="msg-avatar">AI</div>'
      + '<div class="msg-body">'
      +   '<div class="msg-name">RAG 助手</div>'
      +   '<div class="msg-content">' + body + '</div>'
      + '</div>';

    els.chat.appendChild(msgEl);

    if (persist !== false) {
      state.messages.push({
        role: 'assistant',
        content: content,
        citations: citations || [],
        ts: new Date().toISOString(),
      });
    }

    // 绑定该条消息内 cite 点击 -> 展开引用卡
    bindCitationClicks(msgEl);
    scrollChatToBottom();
  }

  /** 追加错误消息(LLM 失败等) */
  function appendErrorMessage(content) {
    const welcome = els.chat.querySelector('.welcome');
    if (welcome) welcome.remove();

    const el = document.createElement('div');
    el.className = 'msg error';
    el.innerHTML =
      '<div class="msg-avatar">!</div>'
      + '<div class="msg-body">'
      +   '<div class="msg-name">错误</div>'
      +   '<div class="msg-content"><p>' + nl2br(content) + '</p></div>'
      + '</div>';
    els.chat.appendChild(el);
    scrollChatToBottom();
  }

  /** 渲染 AI 主体内容(markdown + sources footer) */
  function renderAIBody(content, citations) {
    let html = renderMarkdown(content || '');

    // 如果有引用,在末尾加 sources 列表
    if (citations && citations.length) {
      const items = citations.map(function (c, i) {
        const num = i + 1;
        const src = c.source || c.filename || '未知来源';
        const page = c.page != null && c.page !== '' ? (' p.' + c.page) : '';
        return ''
          + '<span class="source-item" data-cite="' + num + '">'
          +   '<span class="source-num">[' + num + ']</span>'
          +   '<span class="source-name" title="' + escapeHtml(src + page) + '">'
          +     escapeHtml(truncate(src, 20)) + page
          +   '</span>'
          + '</span>';
      }).join('');
      html +=
        '<div class="sources">'
        + '<span class="sources-label">引用来源</span>'
        + items
        + '</div>';
    }
    return html;
  }

  /** 在指定消息节点上绑定 cite 点击 -> 渲染/切换 引用卡 */
  function bindCitationClicks(msgEl) {
    const cites = msgEl.querySelectorAll('.cite, .source-item');
    cites.forEach(function (node) {
      node.addEventListener('click', function (e) {
        e.stopPropagation();
        const num = parseInt(node.dataset.cite, 10);
        if (!num) return;
        toggleCiteCard(msgEl, num);
      });
    });
  }

  /** 在 msgEl 内渲染/切换第 N 个引用卡 */
  function toggleCiteCard(msgEl, n) {
    // 找该 msg 对应的 citations:使用缓存的 state.citations(简化处理:整个 chat 只展示最后一次的)
    // 实际上,每条 AI 消息都有自己的 citations,这里通过当前消息节点上的 sources 反推
    const idx = n - 1;
    const cites = state.citations;
    if (!cites || !cites[idx]) {
      toast('没有可用的引用内容', 'error');
      return;
    }

    // 切换高亮
    msgEl.querySelectorAll('.cite.active, .source-item.active')
      .forEach(function (x) { x.classList.remove('active'); });
    const target = msgEl.querySelector('.cite[data-cite="' + n + '"], .source-item[data-cite="' + n + '"]');
    if (target) target.classList.add('active');

    // 已存在则移除,实现折叠
    const oldCard = msgEl.querySelector('.cite-card[data-cite-card="' + n + '"]');
    if (oldCard) {
      oldCard.remove();
      return;
    }
    // 移除其他已展开的(单展开)
    msgEl.querySelectorAll('.cite-card').forEach(function (c) { c.remove(); });

    const c = cites[idx];
    const card = document.createElement('div');
    card.className = 'cite-card';
    card.dataset.citeCard = String(n);
    card.innerHTML =
      '<div class="cite-card-header">'
      + '<span class="cite-card-source">📄 '
      +   escapeHtml((c.source || c.filename || '未知来源') + (c.page != null && c.page !== '' ? (' · p.' + c.page) : ''))
      + '</span>'
      + '<span class="cite-card-num">[' + n + ']</span>'
      + '</div>'
      + '<div class="cite-card-text">' + escapeHtml(c.snippet || c.content || '(无内容)') + '</div>'
      + (c.score != null ? ('<div class="cite-card-score">相似度: ' + c.score + '</div>') : '');

    // 插入到 sources 之前
    const sources = msgEl.querySelector('.sources');
    if (sources) {
      msgEl.querySelector('.msg-content').insertBefore(card, sources);
    } else {
      msgEl.querySelector('.msg-content').appendChild(card);
    }
  }

  function scrollChatToBottom() {
    requestAnimationFrame(function () {
      els.chatWrap.scrollTop = els.chatWrap.scrollHeight;
    });
  }

  /* =================================================================
   * 发送问题
   * ================================================================= */
  async function sendQuestion(question) {
    question = (question || '').trim();
    if (!question) return;
    if (state.busy) {
      toast('请等待上一次回答完成', 'error');
      return;
    }

    // 1. 立即渲染用户消息 + AI loading
    appendUserMessage(question);
    const loadingEl = document.createElement('div');
    loadingEl.className = 'msg ai';
    loadingEl.innerHTML =
      '<div class="msg-avatar">AI</div>'
      + '<div class="msg-body">'
      +   '<div class="msg-name">RAG 助手</div>'
      +   '<div class="msg-content"><div class="typing">'
      +     '<span class="typing-dot"></span>'
      +     '<span class="typing-dot"></span>'
      +     '<span class="typing-dot"></span>'
      +   '</div></div>'
      + '</div>';
    els.chat.appendChild(loadingEl);
    scrollChatToBottom();

    setBusy(true);
    setStatus('思考中…', false);

    try {
      const payload = {
        question: question,
        session_id: state.sessionId || null,
      };
      const data = await api('/api/chat', {
        method: 'POST',
        body: payload,
      });

      // 后端返回 {answer, citations, session_id}
      loadingEl.remove();

      // 如果之前没有 session_id,接收后端生成的
      if (!state.sessionId && data.session_id) {
        state.sessionId = data.session_id;
        localStorage.setItem(STORAGE_KEY_SESSION, state.sessionId);
      }

      // 缓存本次 citations(给 cite card 用)
      state.citations = Array.isArray(data.citations) ? data.citations : [];

      // 渲染 AI 回答
      appendAIMessage(data.answer || '(空回答)', state.citations, true);

      // 如果标题还是默认的,用首条 user 消息更新
      if (state.sessionTitle === '新会话' || !state.sessionTitle) {
        state.sessionTitle = truncate(question, 40);
        renderSessionTitle();
      }

      // 刷新会话列表(显示新会话)
      await loadSessions();

      setStatus('就绪', true);
    } catch (err) {
      console.error('sendQuestion:', err);
      loadingEl.remove();
      appendErrorMessage(err.message || '请求失败');
      setStatus('出错', false);
    } finally {
      setBusy(false);
    }
  }

  /* =================================================================
   * 状态指示
   * ================================================================= */
  function setBusy(b) {
    state.busy = b;
    els.sendBtn.disabled = b;
    els.composerInput.disabled = b;
  }
  function setStatus(text, ok) {
    els.statusText.textContent = text;
    els.statusDot.classList.toggle('off', !ok);
  }

  /* =================================================================
   * 会话标题编辑
   * ================================================================= */
  function startEditTitle() {
    if (state.editingTitle) return;
    if (!state.sessionId) {
      toast('新会话还没有 id,先发条消息吧', 'error');
      return;
    }
    state.editingTitle = true;
    els.sessionTitle.style.display = 'none';
    els.sessionTitleInput.style.display = 'block';
    els.sessionTitleInput.value = state.sessionTitle;
    els.sessionTitleInput.focus();
    els.sessionTitleInput.select();
  }
  function finishEditTitle(save) {
    if (!state.editingTitle) return;
    state.editingTitle = false;
    els.sessionTitleInput.style.display = 'none';
    els.sessionTitle.style.display = '';
    if (save) {
      const v = (els.sessionTitleInput.value || '').trim();
      if (v && v !== state.sessionTitle) {
        state.sessionTitle = v;
        // 后端没有专门的改名接口,title 是从首条 user 自动生成,所以这里只更新本地显示
        renderSessionTitle();
      }
    }
  }

  /* =================================================================
   * 事件绑定
   * ================================================================= */

  function bindEvents() {
    // ---- 上传 ----
    els.fileInput.addEventListener('change', function (e) {
      handleFiles(e.target.files);
    });
    els.uploadZone.addEventListener('dragover', function (e) {
      e.preventDefault(); els.uploadZone.classList.add('dragover');
    });
    els.uploadZone.addEventListener('dragleave', function () {
      els.uploadZone.classList.remove('dragover');
    });
    els.uploadZone.addEventListener('drop', function (e) {
      e.preventDefault();
      els.uploadZone.classList.remove('dragover');
      handleFiles(e.dataTransfer.files);
    });

    // ---- 文档列表 ----
    els.docList.addEventListener('click', function (e) {
      const delBtn = e.target.closest('.doc-del');
      if (delBtn) {
        const item = delBtn.closest('.doc-item');
        if (item) deleteDocument(item.dataset.source);
      }
    });

    // ---- 会话列表 ----
    els.convList.addEventListener('click', function (e) {
      const delBtn = e.target.closest('.conv-del');
      if (delBtn) {
        const item = delBtn.closest('.conv-item');
        if (item) deleteSession(item.dataset.sid, e);
        return;
      }
      const item = e.target.closest('.conv-item');
      if (item) loadSession(item.dataset.sid);
    });

    // ---- 顶部按钮 ----
    els.newChatBtn.addEventListener('click', startNewChat);
    els.refreshAllBtn.addEventListener('click', function () {
      loadDocuments();
      loadSessions();
      toast('已刷新', 'success');
    });
    els.refreshDocsBtn.addEventListener('click', loadDocuments);
    els.refreshSessionsBtn.addEventListener('click', loadSessions);

    // ---- 发送 ----
    els.sendBtn.addEventListener('click', function () {
      sendQuestion(els.composerInput.value);
      els.composerInput.value = '';
      autoSizeTextarea();
    });
    els.composerInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendQuestion(els.composerInput.value);
        els.composerInput.value = '';
        autoSizeTextarea();
      }
    });
    els.composerInput.addEventListener('input', autoSizeTextarea);

    // ---- 会话标题编辑 ----
    els.sessionTitle.addEventListener('click', startEditTitle);
    els.sessionTitleInput.addEventListener('blur',  function () { finishEditTitle(true); });
    els.sessionTitleInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); finishEditTitle(true); }
      else if (e.key === 'Escape') { finishEditTitle(false); }
    });

    // ---- 示例问题(事件委托) ----
    els.chat.addEventListener('click', function (e) {
      const ex = e.target.closest('.example-item');
      if (ex) {
        const q = ex.dataset.q || ex.textContent.trim();
        sendQuestion(q);
      }
    });
  }

  function autoSizeTextarea() {
    const ta = els.composerInput;
    ta.style.height = 'auto';
    ta.style.height = Math.min(180, ta.scrollHeight) + 'px';
  }

  /* =================================================================
   * 初始化
   * ================================================================= */
  async function init() {
    // 绑定基础事件
    bindEvents();

    // ===== Token 鉴权 =====
    let token = getToken();
    if (token) {
      // 有 token，先验证有效性
      const ok = await verifyToken(token);
      if (!ok) {
        setToken(null);
        token = null;
      }
    }

    if (!token) {
      // 显示 modal，等用户输入
      showTokenModal();
      // 绑定 modal 事件（一次性）
      const submit = document.getElementById('tokenSubmit');
      const input = document.getElementById('tokenInput');
      const handler = async function() {
        const t = input.value.trim();
        if (!t) {
          document.getElementById('tokenError').textContent = '请输入令牌';
          return;
        }
        document.getElementById('tokenError').textContent = '验证中…';
        const ok = await verifyToken(t);
        if (ok) {
          setToken(t);
          hideTokenModal();
          submit.removeEventListener('click', handler);
          input.removeEventListener('keydown', keyHandler);
          // 启动主程序
          startMain();
        } else {
          document.getElementById('tokenError').textContent = '令牌无效,请检查';
          input.select();
        }
      };
      const keyHandler = function(e) {
        if (e.key === 'Enter') handler();
      };
      submit.addEventListener('click', handler);
      input.addEventListener('keydown', keyHandler);
      return; // 不启动主程序
    }

    // 已有有效 token,直接启动
    startMain();
  }

  async function startMain() {
    // 显示退出按钮
    document.getElementById('logoutBtn').style.display = '';
    setStatus('加载中…', false);

    // 并行加载
    await Promise.all([loadDocuments(), loadSessions()]);

    // 恢复上次的会话
    const lastSid = localStorage.getItem(STORAGE_KEY_SESSION);
    if (lastSid) {
      await loadSession(lastSid);
    }

    setStatus('就绪', true);
  }

  // 绑定退出按钮
  document.getElementById('logoutBtn').addEventListener('click', function() {
    if (confirm('确定要清除令牌并退出吗?')) {
      setToken(null);
      location.reload();
    }
  });

  // DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
</body>
</html>